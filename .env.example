# 剧情志 环境变量模板
# 复制为 .env 或在启动前 set / export 均可。所有变量都有安全的默认值，
# 不配置任何密钥时程序照常运行（LLM 相关功能自动降级为纯规则/纯检索模式）。

# ---- LLM（OpenAI 兼容接口，路径 A/B/C 共用）----
# 密钥；留空则不调用 LLM
LLM_API_KEY=
# 接口地址，默认月之暗面
LLM_API_BASE=https://api.moonshot.cn/v1
# 模型名
LLM_MODEL=kimi-k2.6
# 单次请求超时（秒）。推理模型较慢，建议 120-180
LLM_TIMEOUT=120
# 采样温度。kimi-k2.x 只接受 1（程序遇 400 会自动切换）
LLM_TEMPERATURE=0

# ---- 剧情问答 RAG 可选向量后端（storylog_rag.py）----
# 配置后启用「BM25 + 向量」混合检索；不配置则纯 BM25（零依赖，开箱即用）。
# 注意：实测 Moonshot 不开放 /embeddings，如需向量检索请换支持 embeddings 的服务。
STORYLOG_EMBED_API_KEY=
STORYLOG_EMBED_API_BASE=
STORYLOG_EMBED_MODEL=text-embedding-3-small

# ---- Agent 问答（storylog_agent.py，路径 D）----
# 单轮最多 ReAct 步数（模型最多来回几轮）
AGENT_MAX_STEPS=6
# 单轮 token 预算，超出即强制收敛
AGENT_TOKEN_BUDGET=60000
# 单轮墙钟预算（秒），超出即强制收敛
AGENT_TIME_BUDGET=240
# 会话记忆保留的历史轮数
AGENT_MAX_HISTORY_TURNS=6
# 主动限速：>0 时保证最近 60 秒内模型调用不超过该次数。
# 月之暗面免费/低档组织级上限为 RPM=3，配 3 可显著减少 429。填 0 表示不限速。
# ⚠️ RPM 是「组织级」配额：同时跑两个 Agent/评测进程会各自计数、合计超限，
#    表现为「限速开着却仍持续 429」。agent_eval.py 已内置单实例锁防并发。
AGENT_RPM=0
